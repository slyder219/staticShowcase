{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://showcase.seanlyder.com/schemas/project-manifest.schema.json",
  "title": "Static Showcase Project Manifest",
  "description": "Schema for cataloging Python showcase projects in a static site.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "generatedAt", "projects"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional JSON Schema pointer for editor tooling."
    },
    "manifestVersion": {
      "type": "string",
      "description": "Version of the manifest format.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generatedAt": {
      "type": "string",
      "description": "ISO-8601 timestamp for when the file was generated.",
      "format": "date-time"
    },
    "basePath": {
      "type": "string",
      "description": "Optional base path prefix used when resolving relative file paths.",
      "default": "."
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/project"
      }
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "year",
        "runtimeMode",
        "entry",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable key used for URLs and lookups.",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "integer",
          "minimum": 1980,
          "maximum": 2100
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": []
        },
        "runtimeMode": {
          "type": "string",
          "description": "How the project is presented/executed in the site.",
          "enum": ["pyodide", "terminal-sim", "static"]
        },
        "status": {
          "type": "string",
          "description": "Execution support status.",
          "enum": ["planned", "playable", "read-only"]
        },
        "entry": {
          "$ref": "#/$defs/entry"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repoUrl": {
              "type": "string",
              "format": "uri"
            },
            "commit": {
              "type": "string"
            }
          }
        },
        "terminal": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bootCommand": {
              "type": "string"
            },
            "allowedCommands": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true,
              "default": []
            },
            "prompt": {
              "type": "string",
              "default": "showcase@project:$ "
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "entry": {
      "type": "object",
      "description": "Entry point and file locations. All paths are relative to the repository root unless basePath is used.",
      "additionalProperties": false,
      "required": ["projectRoot", "scriptType"],
      "anyOf": [
        {
          "required": ["scriptPath"]
        },
        {
          "required": ["scriptLocation"]
        }
      ],
      "properties": {
        "projectRoot": {
          "type": "string",
          "description": "Relative folder containing this project.",
          "pattern": "^(?!/|[A-Za-z]:|.*\\.\\.).+"
        },
        "scriptLocation": {
          "type": "string",
          "description": "Relative path to the primary runnable script, for example projects/foo/main.py.",
          "pattern": "^(?!/|[A-Za-z]:|.*\\.\\.).+"
        },
        "scriptPath": {
          "type": "string",
          "description": "Relative path to the primary runnable script, for example py_scripts/foo/main.py.",
          "pattern": "^(?!/|[A-Za-z]:|.*\\.\\.).+"
        },
        "scriptType": {
          "type": "string",
          "enum": ["python", "javascript", "none"]
        },
        "assetsPath": {
          "type": "string",
          "description": "Optional relative path to screenshots, fixtures, or project assets.",
          "pattern": "^(?!/|[A-Za-z]:|.*\\.\\.).+"
        },
        "readmePath": {
          "type": "string",
          "description": "Optional relative path to the original README.",
          "pattern": "^(?!/|[A-Za-z]:|.*\\.\\.).+"
        }
      }
    }
  }
}
